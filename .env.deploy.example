# Пример переменных для предэксплуатационного окружения (CD).
# Скопируйте в .env.deploy на целевом сервере и заполните реальными значениями.
# В репозиторий .env.deploy не коммитится (см. .gitignore).

# --- База данных (используется и сервисом db, и приложением) ---
POSTGRES_DB=confplus
POSTGRES_USER=confplus_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Приложение ---
# ВАЖНО: host = db (имя сервиса в docker-сети), а не localhost
DATABASE_URL=postgresql+psycopg://confplus_user:CHANGE_ME_STRONG_PASSWORD@db:5432/confplus
SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEBUG=false
HOST=0.0.0.0
PORT=8000

# --- Registry ---
CI_REGISTRY_IMAGE=registry.example.com/my_devops_group/conf-plus
# APP_VERSION подставляется в docker-compose.deploy.yml из переменной окружения при деплое
